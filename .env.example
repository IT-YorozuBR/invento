ADMIN_PASSWORD=Admin@123
APP_DEBUG=true
APP_ENV=development
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
# true para bancos gerenciados com TLS (Neon, RDS...); false para Postgres em container próprio
DATABASE_SSL=false
ITEMS_PER_PAGE=20
NEXTAUTH_URL=url da api
PORT=10000
SESSION_SECRET=your-super-secret-key-change-this-in-production
SESSION_TIMEOUT=3600

# --- Usadas apenas pelo docker-compose (serviço "db") ---
# O DATABASE_URL acima é sobrescrito pelo compose para apontar para o
# container "db" usando estas credenciais (host=db, sslmode desabilitado).
POSTGRES_USER=invento
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=invento
