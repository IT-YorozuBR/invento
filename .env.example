ADMIN_PASSWORD=Admin@123
APP_DEBUG=true
APP_ENV=development
# Usado apenas fora do docker-compose (ex.: Neon, Render). Dentro do compose,
# a conexão usa PGHOST/PGUSER/PGPASSWORD/PGDATABASE definidos mais abaixo.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
# true para bancos gerenciados com TLS (Neon, RDS...); false para Postgres em container próprio
DATABASE_SSL=false
ITEMS_PER_PAGE=20
PORT=10000
SESSION_SECRET=your-super-secret-key-change-this-in-production
SESSION_TIMEOUT=3600
# Cookie de sessão exige HTTPS por padrão em produção. Se o sistema for servido
# só por HTTP (ex.: domínio .local interno, sem certificado válido), defina
# como "false" — senão o navegador descarta o cookie e o login nunca "gruda".
SESSION_COOKIE_SECURE=true

# --- Usadas apenas pelo docker-compose (serviço "db") ---
# O app dentro do compose usa PGHOST=db + estas credenciais diretamente
# (variáveis discretas), não a DATABASE_URL acima.
POSTGRES_USER=invento
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=invento
